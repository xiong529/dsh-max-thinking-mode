{
  "name": "@dsh-max-thinking/tool-isolated-review",
  "description": "Model-facing isolated review tool for the Max Thinking mode bundle: spawns a tool-free reviewer that re-thinks a proposal from a different angle and tries to refute it",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "src",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.0",
    "@deepseek-ai/dsh-subagent": ">=0.0.1-rc.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.0",
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/cordis-plugin-loader": "^0.0.1-rc.0",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.0",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.0",
    "@deepseek-ai/dsh-subagent": "^0.0.1-rc.0",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.0",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.0",
    "tsx": "^4.0.0",
    "tsdown": "^0.3.0"
  }
}